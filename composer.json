{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "art35rennes/laravel-daisy-kit-demo",
    "type": "project",
    "description": "Executable documentation for Laravel Daisy Kit v5.",
    "keywords": ["laravel", "daisyui", "documentation"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "livewire/livewire": "^4.3"
    },
    "require-dev": {
        "laravel/boost": "^2.6",
        "laravel/pint": "^1.27",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest tests/Feature tests/Arch --no-tia",
        "test:browser": "pest tests/Browser --no-tia",
        "test:release": [
            "@php vendor/bin/pest tests/Feature tests/Arch --no-tia",
            "@php vendor/bin/pest tests/Browser --no-tia"
        ],
        "test:tia": "pest --tia",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": []
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
